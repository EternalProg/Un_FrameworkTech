{
  "name": "framework-tech-labs",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "predev": "npm run check",
    "dev": "node --watch app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "imports": {
    "#config": "./config/index.js",
    "#controllers/*": "./controllers/*.js",
    "#data/*": "./data/*.js",
    "#routes/*": "./routes/*.js",
    "#services/*": "./services/*.js",
    "#utils/*": "./utils/*.js",
    "#validators/*": "./validators/*.js"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "fastify": "^5.8.2"
  }
}
