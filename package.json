{
  "name": "framework-tech-labs",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "predev": "npm run check",
    "dev": "node --watch app.js",
    "seed": "node src/scripts/seed.js",
    "migrate": "node src/migrations/migrate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "imports": {
    "#constants/*": "./constants/*.js",
    "#controllers/*": "./controllers/*.js",
    "#data/*": "./data/*.js",
    "#repositories/*": "./repositories/*.js",
    "#routes/*": "./routes/*.js",
    "#schemas/*": "./schemas/*.js",
    "#services/*": "./services/*.js",
    "#src/*": "./src/*.js",
    "#src-models/*": "./src/models/*.js",
    "#src-utils/*": "./src/utils/*.js",
    "#src-migrations/*": "./src/migrations/*.js"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/static": "^8.3.0",
    "ajv": "^8.17.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "fastify": "^5.8.2"
  }
}
