{
  "name": "framework-tech-labs",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "predev": "npm run check",
    "dev": "node --watch app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "imports": {
    "#constants/*": "./constants/*.js",
    "#controllers/*": "./controllers/*.js",
    "#data/*": "./data/*.js",
    "#routes/*": "./routes/*.js",
    "#schemas/*": "./schemas/*.js",
    "#services/*": "./services/*.js"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@fastify/env": "^5.0.3",
    "@fastify/sensible": "^6.0.4",
    "fastify": "^5.8.2"
  }
}
