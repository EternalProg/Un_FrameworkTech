{
  "name": "framework-tech-labs",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "predev": "npm run check",
    "dev": "node --watch app.js",
    "seed": "node src/scripts/seed.js",
    "seed:force": "node src/scripts/seed.js --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "external": "json-server db.json --port 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "imports": {
    "#constants/*": "./constants/*.js",
    "#controllers/*": "./controllers/*.js",
    "#data/*": "./data/*.js",
    "#repositories/*": "./repositories/*.js",
    "#routes/*": "./routes/*.js",
    "#schemas/*": "./schemas/*.js",
    "#services/*": "./services/*.js",
    "#src/*": "./src/*.js",
    "#src-models/*": "./src/models/*.js",
    "#src-utils/*": "./src/utils/*.js",
    "#src-migrations/*": "./src/migrations/*.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.3",
    "json-server": "^1.0.0-beta.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "ajv": "^8.17.1",
    "argon2": "^0.44.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "mysql2": "^3.22.3"
  }
}
